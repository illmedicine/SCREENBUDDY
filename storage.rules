rules_version = '2';

// Screen Buddy file storage. Everything is closed unless a rule below opens it.
//
//   uploads/{uid}/{characterId}/video.<ext>   a video a person uploaded on the dashboard to make a buddy. Only they can
//                                             read it; they can add it once (video only, up to 100 MB) and never
//                                             overwrite or delete it, so an existing buddy's video can't be swapped.
//                                             The processing worker (Admin SDK) reads it and cleans up afterwards.
//
// Keep the size limit in step with VIDEO_FILE_MAX in screen-buddy-starter/web/js/library.js.
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{uid}/{cid}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && cid.matches('[A-Za-z0-9_-]{6,64}')
        && file.matches('video[.][a-z0-9]{2,5}')
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow update, delete: if false;
    }

    // A video the admin uploads on the admin page's "Add buddy" form (up to 300 MB). The worker reads it and deletes it.
    match /uploads/admin/{jobId}/{file} {
      allow create: if request.auth != null
        && (request.auth.token.get('admin', false) == true
            || (request.auth.token.get('email_verified', false) == true
                && request.auth.token.get('email', '') in ['demarkuswilsone@gmail.com']))
        && jobId.matches('[A-Za-z0-9_-]{6,64}')
        && file.matches('video[.][a-z0-9]{2,5}')
        && request.resource.size <= 300 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
    }

    // Finished buddies (manifest.json, face.webp, strips, buddy.zip) that the worker publishes. Everyone can load them.
    match /buddies/{rest=**} {
      allow read: if true;
    }

    match /{all=**} {
      allow read, write: if false;
    }
  }
}
