rules_version = '2';

// Screen Buddy file storage. Everything is closed unless a rule below opens it.
//
//   uploads/{uid}/{characterId}/video.<ext>   a video a person uploaded on the dashboard to make a buddy. Only they can
//                                             read it; they can add it once (video only, up to 100 MB) and never
//                                             overwrite or delete it, so an existing buddy's video can't be swapped.
//                                             The processing worker (Admin SDK) reads it and cleans up afterwards.
//
// Keep the size limit in step with VIDEO_FILE_MAX in screen-buddy-starter/web/js/library.js.
service firebase.storage {
  match /b/{bucket}/o {
    match /uploads/{uid}/{cid}/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create: if request.auth != null && request.auth.uid == uid
        && cid.matches('[A-Za-z0-9_-]{6,64}')
        && file.matches('video[.][a-z0-9]{2,5}')
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType.matches('video/.*');
      allow update, delete: if false;
    }

    match /{all=**} {
      allow read, write: if false;
    }
  }
}
