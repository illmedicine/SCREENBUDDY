<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>   <!-- for the system tray icon and its menu -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>  <!-- WPF and WinForms both define Application, Button...: be explicit -->
    <AssemblyName>ScreenBuddy</AssemblyName>
    <RootNamespace>ScreenBuddy.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>         <!-- exe, installer, taskbar and shortcut icon: tools/make_icons.py -->
    <Version>0.2.0</Version>                           <!-- dev builds only: release builds take it from the windows-v tag -->

    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="SkiaSharp" Version="3.119.1" />   <!-- decodes the WebP strips -->
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />   <!-- microphone level for sound-activated movement -->
    <ProjectReference Include="..\ScreenBuddy.Core\ScreenBuddy.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The sample buddies ship next to the exe. -->
    <Content Include="buddies\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The brand icon again, readable at runtime for the still tray icon (tools/make_icons.py generates it). -->
    <EmbeddedResource Include="app.ico" LogicalName="ScreenBuddy.app.ico" />
  </ItemGroup>
</Project>
